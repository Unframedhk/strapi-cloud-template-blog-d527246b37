{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "projectName": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "website": {
      "type": "string",
      "maxLength": 200
    },
    "seoTitle": {
      "type": "text"
    },
    "seoDescription": {
      "type": "text"
    },
    "markdown": {
      "type": "richtext"
    },
    "slug": {
      "type": "uid"
    },
    "excerpt": {
      "type": "string"
    },
    "featuredImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "readingTime": {
      "type": "integer"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "project": {
      "type": "enumeration",
      "enum": [
        "replicamera",
        "starry",
        "onems"
      ]
    }
  }
}
